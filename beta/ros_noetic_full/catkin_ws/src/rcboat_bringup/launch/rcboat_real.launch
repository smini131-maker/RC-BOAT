<launch>
  <arg name="core_dir" default="$(find rcboat_core)" />
  <arg name="arduino_port" default="/dev/serial/by-id/usb-Arduino__www.arduino.cc__Arduino_Uno_55639303534351D01210-if00" />

  <node pkg="ublox_gps" type="ublox_gps" name="ublox_gps" output="screen" respawn="true" respawn_delay="3">
    <rosparam command="load" file="$(arg core_dir)/config/ublox_zed_f9r.yaml" />
  </node>

  <node pkg="rcboat_core" type="arduino_node.py" name="rcboat_arduino" output="screen" respawn="true">
    <param name="port" value="$(arg arduino_port)" />
    <param name="baudrate" value="9600" />
  </node>

  <node pkg="rcboat_core" type="ntrip_node.py" name="rcboat_ntrip" output="screen" respawn="true">
    <param name="env_file" value="$(arg core_dir)/config/ntrip.env" />
  </node>

  <node pkg="rcboat_core" type="gps_health_node.py" name="rcboat_gps_health" output="screen" respawn="true">
    <param name="stale_s" value="2.0" />
  </node>

  <node pkg="rcboat_core" type="controller_node.py" name="rcboat_controller" output="screen" required="true">
    <param name="config_file" value="$(arg core_dir)/config/boat.yaml" />
    <param name="routes_file" value="$(arg core_dir)/config/routes.json" />
  </node>

  <node pkg="rcboat_core" type="gps_logger_node.py" name="rcboat_gps_logger" output="screen" respawn="true">
    <param name="log_dir" value="$(arg core_dir)/logs/gps" />
  </node>

  <node pkg="rcboat_core" type="pca9685_node.py" name="rcboat_pca9685" output="screen" required="true">
    <param name="bus" value="1" />
    <param name="address" value="0x40" />
    <param name="frequency_hz" value="60" />
    <param name="watchdog_timeout_s" value="0.3" />
  </node>
</launch>
