<?xml version="1.0"?>
<package format="2">
  <name>rcboat_core</name>
  <version>0.1.0</version>
  <description>ROS-native hardware, control, navigation, GPS health and NTRIP nodes.</description>
  <maintainer email="smini131-maker@users.noreply.github.com">smini131-maker</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>rcboat_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
