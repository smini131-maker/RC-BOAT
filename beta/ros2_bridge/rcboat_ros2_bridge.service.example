[Unit]
Description=RC Boat ROS 2 Bridge Beta
After=network.target rcboat.service
Requires=rcboat.service

[Service]
Type=simple
User=jetson
Group=jetson
Environment=ROS_DISTRO=foxy
WorkingDirectory=/home/jetson/RC-BOAT/beta/ros2_bridge
ExecStart=/home/jetson/RC-BOAT/beta/ros2_bridge/run_bridge.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
